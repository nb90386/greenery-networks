# Greenery Networks environment variables.
#
# Copy this file to `.env.local` for local development. Do not commit
# `.env.local`. Values below are placeholders. Empty is fine while the
# feature they belong to has not been wired up yet.

# --- Site ---------------------------------------------------------------
# The canonical, public URL of the site. Used for absolute URLs in
# metadata, JSON-LD, sitemap.xml, and canonical links.
NEXT_PUBLIC_SITE_URL="https://greenerynetworks.com"

# --- Shopify Storefront (wired in Prompt 8) ------------------------------
# These are used by lib/checkout.ts to create real Shopify carts.
# Until they are set, `startCheckout()` returns the placeholder response and
# the checkout button on /cart stays disabled with the friendly message.
SHOPIFY_STORE_DOMAIN=""
SHOPIFY_STOREFRONT_ACCESS_TOKEN=""
SHOPIFY_API_VERSION="2025-07"

# --- Optional: newsletter / analytics -------------------------------------
# NEXT_PUBLIC_KLAVIYO_LIST_ID=""
# NEXT_PUBLIC_GA4_MEASUREMENT_ID=""
